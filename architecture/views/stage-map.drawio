<mxfile host="app.diagrams.net" agent="gen_views.py"><diagram id="stages" name="Stage map"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="stages-1" value="&lt;b&gt;Stage map&lt;/b&gt;: 6 fixed stages, each with an artifact and a check; loop-backs owned by the orchestrator" style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="stages-2" value="&lt;b&gt;1 Requirements&lt;/b&gt;&lt;br&gt;&lt;i&gt;Builder (fresh ctx) + A1 skill&lt;/i&gt;&lt;br&gt;&lt;br&gt;artifact: &lt;b&gt;spec.md&lt;/b&gt;&lt;br&gt;&lt;font color='#006600'&gt;check: every AC has id + Given/When/Then&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="stages-3" value="&lt;b&gt;2 Design&lt;/b&gt;&lt;br&gt;&lt;i&gt;Builder (fresh ctx) + ARCHITECTURE.md&lt;/i&gt;&lt;br&gt;&lt;br&gt;artifact: &lt;b&gt;design.md&lt;/b&gt;&lt;br&gt;&lt;font color='#006600'&gt;check: named files + functions exist (AST)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="stages-4" value="&lt;b&gt;3 Implement&lt;/b&gt;&lt;br&gt;&lt;i&gt;Builder (fresh ctx), branch autose/issue-N&lt;/i&gt;&lt;br&gt;&lt;br&gt;artifact: &lt;b&gt;diff.patch&lt;/b&gt;&lt;br&gt;&lt;font color='#006600'&gt;check: uv sync, import, ruff, mypy, diff_guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="stages-5" value="&lt;b&gt;4 Test&lt;/b&gt;&lt;br&gt;&lt;i&gt;Builder (fresh ctx)&lt;/i&gt;&lt;br&gt;&lt;br&gt;artifact: &lt;b&gt;test_report.md&lt;/b&gt;&lt;br&gt;&lt;font color='#006600'&gt;check: pytest old + new, ≥1 test per AC id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="stages-6" value="&lt;b&gt;5 Release&lt;/b&gt;&lt;br&gt;&lt;i&gt;orchestrator (no LLM), gh CLI&lt;/i&gt;&lt;br&gt;&lt;br&gt;artifact: &lt;b&gt;pr.md + PR link&lt;/b&gt;&lt;br&gt;&lt;font color='#006600'&gt;check: PR open + tests.yml green&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="stages-7" value="&lt;b&gt;6 Review&lt;/b&gt;&lt;br&gt;&lt;i&gt;Reviewer: own job, gemini-3.5-flash-lite, read-only&lt;/i&gt;&lt;br&gt;&lt;br&gt;artifact: &lt;b&gt;review.md + verdict.json&lt;/b&gt;&lt;br&gt;&lt;font color='#006600'&gt;check: approve, or 2 rounds used&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1370" y="200" width="220" height="150" as="geometry"/></mxCell><mxCell id="stages-8" value="Issue + label &lt;i&gt;autose&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="220" height="50" as="geometry"/></mxCell><mxCell id="stages-9" value="&lt;b&gt;Human decides&lt;/b&gt;&lt;br&gt;merge or close" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1370" y="520" width="220" height="70" as="geometry"/></mxCell><mxCell id="stages-10" value="&lt;b&gt;STOP&lt;/b&gt;&lt;br&gt;reason written in the failing stage's artifact&lt;br&gt;label autose:failed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="490" height="70" as="geometry"/></mxCell><mxCell id="stages-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-8" target="stages-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-12" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-2" target="stages-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-13" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-3" target="stages-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-14" value="builds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-4" target="stages-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-15" value="all pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-5" target="stages-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-16" value="PR open, CI green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-6" target="stages-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-17" value="tests fail:&lt;br&gt;retry ≤ 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-5" target="stages-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="160"/><mxPoint x="670" y="160"/></Array></mxGeometry></mxCell><mxCell id="stages-18" value="still failing:&lt;br&gt;redesign ≤ 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-5" target="stages-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="120"/><mxPoint x="400" y="120"/></Array></mxGeometry></mxCell><mxCell id="stages-19" value="code issue (round 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-7" target="stages-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="420"/><mxPoint x="640" y="420"/></Array></mxGeometry></mxCell><mxCell id="stages-20" value="approach issue (round 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-7" target="stages-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="470"/><mxPoint x="370" y="470"/></Array></mxGeometry></mxCell><mxCell id="stages-21" value="approve / rounds used up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stages-7" target="stages-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stages-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;endArrow=open;" edge="1" parent="1" source="stages-2" target="stages-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="560"/><mxPoint x="805" y="560"/></Array></mxGeometry></mxCell><mxCell id="stages-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;endArrow=open;" edge="1" parent="1" source="stages-3" target="stages-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="560"/><mxPoint x="805" y="560"/></Array></mxGeometry></mxCell><mxCell id="stages-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;endArrow=open;" edge="1" parent="1" source="stages-4" target="stages-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="560"/><mxPoint x="805" y="560"/></Array></mxGeometry></mxCell><mxCell id="stages-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;endArrow=open;" edge="1" parent="1" source="stages-5" target="stages-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="560"/><mxPoint x="805" y="560"/></Array></mxGeometry></mxCell><mxCell id="stages-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;endArrow=open;" edge="1" parent="1" source="stages-6" target="stages-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="560"/><mxPoint x="805" y="560"/></Array></mxGeometry></mxCell><mxCell id="stages-27" value="Budgets: turn limit per agent call, token cap per run (from stream-json stats), timeout-minutes per job. Every arrow back is chosen by orchestrator.py (code), never by an agent." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="jobs" name="Job graph (Actions)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="jobs-1" value="&lt;b&gt;Actions job graph&lt;/b&gt;: the review loop is unrolled into fixed jobs (max 2 rounds, no recursion)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="jobs-2" value="&lt;b&gt;gate&lt;/b&gt;&lt;br&gt;authorise + parse" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="150" height="70" as="geometry"/></mxCell><mxCell id="jobs-3" value="&lt;b&gt;build&lt;/b&gt;&lt;br&gt;stages 1–5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="150" height="70" as="geometry"/></mxCell><mxCell id="jobs-4" value="&lt;b&gt;review-1&lt;/b&gt;&lt;br&gt;read-only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="150" height="70" as="geometry"/></mxCell><mxCell id="jobs-5" value="&lt;b&gt;publish-1&lt;/b&gt;&lt;br&gt;no LLM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="590" y="150" width="150" height="70" as="geometry"/></mxCell><mxCell id="jobs-6" value="&lt;b&gt;rework-1&lt;/b&gt;&lt;br&gt;route 2 or 3, rerun 4–5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="170" height="70" as="geometry"/></mxCell><mxCell id="jobs-7" value="&lt;b&gt;review-2&lt;/b&gt;&lt;br&gt;read-only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="150" height="70" as="geometry"/></mxCell><mxCell id="jobs-8" value="&lt;b&gt;publish-2&lt;/b&gt;&lt;br&gt;no LLM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="150" height="70" as="geometry"/></mxCell><mxCell id="jobs-9" value="&lt;b&gt;finalize&lt;/b&gt; (always)&lt;br&gt;summary + label" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1370" y="150" width="170" height="70" as="geometry"/></mxCell><mxCell id="jobs-10" value="&lt;b&gt;mode = review&lt;/b&gt;&lt;br&gt;(/autose review on a PR,&lt;br&gt;used for seeded PRs)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="210" y="330" width="170" height="80" as="geometry"/></mxCell><mxCell id="jobs-11" value="mode=build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jobs-2" target="jobs-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jobs-12" value="PR #" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jobs-3" target="jobs-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jobs-13" value="artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="jobs-4" target="jobs-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="jobs-14"