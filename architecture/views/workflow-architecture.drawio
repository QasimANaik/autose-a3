; open PR; dispatch CI" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="540" y="134" width="270" height="64" as="geometry"/></mxCell><mxCell id="wfwho-16" value="merge (never calls merge)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="810" y="134" width="280" height="64" as="geometry"/></mxCell><mxCell id="wfwho-17" value="&lt;b&gt;builder agents&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="198" width="150" height="64" as="geometry"/></mxCell><mxCell id="wfwho-18" value="gemini -p (Flash)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="198" width="110" height="64" as="geometry"/></mxCell><mxCell id="wfwho-19" value="only its stage's inputs; issue wrapped as untrusted" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="280" y="198" width="260" height="64" as="geometry"/></mxCell><mxCell id="wfwho-20" value="read/edit files; uv run pytest | ruff | mypy | python" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="540" y="198" width="270" height="64" as="geometry"/></mxCell><mxCell id="wfwho-21" value="network, git push/commit, gh, edit outside its folder (reverted)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spa