<mxfile host="app.diagrams.net" agent="gen_views.py"><diagram id="wfjobs" name="1 Job graph + permissions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wfjobs-1" value="&lt;b&gt;AutoSE: Actions job graph&lt;/b&gt; (permissions per job; workflow default &lt;font face='Courier New'&gt;permissions: {}&lt;/font&gt;)" style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="24" as="geometry"/></mxCell><mxCell id="wfjobs-2" value="&lt;b style='font-size:14px'&gt;gate&lt;/b&gt;&lt;br&gt;who triggered? which mode?&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;issues: write&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;no LLM · no secrets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-3" value="&lt;b style='font-size:14px'&gt;build · stages 1–5&lt;/b&gt;&lt;br&gt;4 builder calls + checks&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;contents, PRs, issues,&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;actions: write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-4" value="&lt;b style='font-size:14px'&gt;review-1&lt;/b&gt;&lt;br&gt;reviewer agent (gemini-3-pro-preview)&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;contents: read&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;pull-requests: read&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="60" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-5" value="&lt;b style='font-size:14px'&gt;publish-1&lt;/b&gt;&lt;br&gt;posts review, sets label&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;pull-requests: write&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;no LLM · no API key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="60" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-6" value="&lt;b style='font-size:14px'&gt;rework-1&lt;/b&gt;&lt;br&gt;code issue → stage 3&lt;br&gt;approach issue → stage 2&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;then 4 → 5 again&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="280" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-7" value="&lt;b style='font-size:14px'&gt;review-2&lt;/b&gt;&lt;br&gt;new reviewer call&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;contents: read&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;pull-requests: read&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="280" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-8" value="&lt;b style='font-size:14px'&gt;publish-2&lt;/b&gt;&lt;br&gt;posts final review&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;pull-requests: write&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;no LLM · no API key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-9" value="&lt;b style='font-size:14px'&gt;finalize&lt;/b&gt;&lt;br&gt;summary comment + label&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;issues, PRs: write&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#555555'&gt;always runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="200" height="92" as="geometry"/></mxCell><mxCell id="wfjobs-10" value="&lt;b style='font-size:14px'&gt;Human&lt;/b&gt;&lt;br&gt;merge or close the PR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="432" width="200" height="60" as="geometry"/></mxCell><mxCell id="wfjobs-11" value="" style="html=1;endArrow=block;endFill=1;rounded=0;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="60" as="sourcePoint"/><mxPoint x="680" y="60" as="targetPoint"/><Array as="points"><mxPoint x="120" y="32"/><mxPoint x="680" y="32"/></Array></mxGeometry></mxCell><mxCell id="wfjobs-12" value="mode=review · /autose review on a PR" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="10" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-13" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="106" as="sourcePoint"/><mxPoint x="300" y="106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-14" value="build" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="82" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-15" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="106" as="sourcePoint"/><mxPoint x="580" y="106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-16" value="PR #" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430" y="82" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-17" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="106" as="sourcePoint"/><mxPoint x="860" y="106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-18" value="verdict" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="82" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-19" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="152" as="sourcePoint"/><mxPoint x="1010" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-20" value="changes requested" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="970" y="202" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-21" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="152" as="sourcePoint"/><mxPoint x="120" y="280" as="targetPoint"/><Array as="points"><mxPoint x="900" y="218"/><mxPoint x="120" y="218"/></Array></mxGeometry></mxCell><mxCell id="wfjobs-22" value="approved in round 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="196" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-23" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="326" as="sourcePoint"/><mxPoint x="780" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-24" value="push" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="710" y="302" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-25" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="326" as="sourcePoint"/><mxPoint x="500" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-26" value="verdict" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430" y="302" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-27" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="326" as="sourcePoint"/><mxPoint x="220" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-28" value="final" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="302" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-29" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="372" as="sourcePoint"/><mxPoint x="120" y="432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfjobs-30" value="done | needs-human | failed" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="130" y="390" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfjobs-31" value="No edge leaves review-2: two review rounds is a hard limit. If round 2 still requests changes, finalize labels the issue autose:needs-human.&lt;br&gt;The bot never calls merge, and CODEOWNERS means a bot approval cannot satisfy the ruleset. Reviewer jobs get a read-only token and never download build artifacts." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="760" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="wfstages" name="2 Build job state machine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wfstages-1" value="&lt;b&gt;Inside the build job&lt;/b&gt;: orchestrator.py runs each stage as a fresh &lt;font face='Courier New'&gt;gemini -p&lt;/font&gt; call, checks it in code, reverts files the stage may not touch, and picks the next step" style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1080" height="24" as="geometry"/></mxCell><mxCell id="wfstages-2" value="&lt;b style='font-size:14px'&gt;1 · Requirements&lt;/b&gt;&lt;br&gt;agent + A1 skill&lt;br&gt;&lt;font face='Courier New'&gt;→ spec.md&lt;/font&gt;&lt;br&gt;&lt;font color='#555555'&gt;ACs in Given/When/Then,&lt;br&gt;no vague words&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#b85450'&gt;retry ≤1, then STOP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="170" height="124" as="geometry"/></mxCell><mxCell id="wfstages-3" value="&lt;b style='font-size:14px'&gt;2 · Design&lt;/b&gt;&lt;br&gt;agent + ARCHITECTURE.md&lt;br&gt;&lt;font face='Courier New'&gt;→ design.md&lt;/font&gt;&lt;br&gt;&lt;font color='#555555'&gt;named files + functions&lt;br&gt;exist (AST)&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#b85450'&gt;retry ≤1, then STOP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="242" y="130" width="170" height="124" as="geometry"/></mxCell><mxCell id="wfstages-4" value="&lt;b style='font-size:14px'&gt;3 · Implement&lt;/b&gt;&lt;br&gt;may edit src/ only&lt;br&gt;&lt;font face='Courier New'&gt;→ diff.patch&lt;/font&gt;&lt;br&gt;&lt;font color='#555555'&gt;import, ruff,&lt;br&gt;strict mypy&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#b85450'&gt;retry ≤2, then STOP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="464" y="130" width="170" height="124" as="geometry"/></mxCell><mxCell id="wfstages-5" value="&lt;b style='font-size:14px'&gt;4 · Test&lt;/b&gt;&lt;br&gt;may edit tests/ only&lt;br&gt;&lt;font face='Courier New'&gt;→ test_report.md&lt;/font&gt;&lt;br&gt;&lt;font color='#555555'&gt;full pytest green,&lt;br&gt;every AC has a test&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#b85450'&gt;loops above, then STOP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="686" y="130" width="170" height="124" as="geometry"/></mxCell><mxCell id="wfstages-6" value="&lt;b style='font-size:14px'&gt;5 · Release&lt;/b&gt;&lt;br&gt;code + gh CLI&lt;br&gt;&lt;font face='Courier New'&gt;→ pr.md + PR link&lt;/font&gt;&lt;br&gt;&lt;font color='#555555'&gt;PR open, tests.yml&lt;br&gt;run green&lt;/font&gt;&lt;br&gt;&lt;font face='Courier New' color='#b85450'&gt;loop below, then STOP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="908" y="130" width="170" height="124" as="geometry"/></mxCell><mxCell id="wfstages-7" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="192" as="sourcePoint"/><mxPoint x="242" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfstages-8" value="pass" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="106" y="168" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-9" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="412" y="192" as="sourcePoint"/><mxPoint x="464" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfstages-10" value="pass" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="328" y="168" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-11" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="634" y="192" as="sourcePoint"/><mxPoint x="686" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfstages-12" value="pass" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="550" y="168" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-13" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="192" as="sourcePoint"/><mxPoint x="908" y="192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wfstages-14" value="pass" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="772" y="168" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-15" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="130" as="sourcePoint"/><mxPoint x="330" y="130" as="targetPoint"/><Array as="points"><mxPoint x="780" y="58"/><mxPoint x="330" y="58"/></Array></mxGeometry></mxCell><mxCell id="wfstages-16" value="tests still fail · redesign ≤1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="445" y="36" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-17" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="130" as="sourcePoint"/><mxPoint x="600" y="130" as="targetPoint"/><Array as="points"><mxPoint x="720" y="100"/><mxPoint x="600" y="100"/></Array></mxGeometry></mxCell><mxCell id="wfstages-18" value="tests fail · ≤2" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="78" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-19" value="" style="html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="254" as="sourcePoint"/><mxPoint x="560" y="254" as="targetPoint"/><Array as="points"><mxPoint x="960" y="294"/><mxPoint x="560" y="294"/></Array></mxGeometry></mxCell><mxCell id="wfstages-20" value="CI fails · ≤1, with the CI log" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Courier New;labelBackgroundColor=#ffffff;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="220" height="20" as="geometry"/></mxCell><mxCell id="wfstages-21" value="Every red arrow is chosen by code from a check result, never by an agent. On STOP the reason is appended to that stage's artifact and finalize labels the issue autose:failed. A per-run token budget and per-call turn limits stop runaway agents." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1060" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="wfwho" name="3 Who holds what"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wfwho-1" value="&lt;b&gt;Who holds what&lt;/b&gt;: no agent ever receives a GitHub token" style="text;html=1;align=left;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="24" as="geometry"/></mxCell><mxCell id="wfwho-2" value="&lt;b&gt;Component&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="150" height="30" as="geometry"/></mxCell><mxCell id="wfwho-3" value="&lt;b&gt;Kind&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="170" y="40" width="110" height="30" as="geometry"/></mxCell><mxCell id="wfwho-4" value="&lt;b&gt;Sees&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="260" height="30" as="geometry"/></mxCell><mxCell id="wfwho-5" value="&lt;b&gt;Can&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="40" width="270" height="30" as="geometry"/></mxCell><mxCell id="wfwho-6" value="&lt;b&gt;Cannot&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="810" y="40" width="280" height="30" as="geometry"/></mxCell><mxCell id="wfwho-7" value="&lt;b&gt;gate.py&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="150" height="64" as="geometry"/></mxCell><mxCell id="wfwho-8" value="code" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" ve