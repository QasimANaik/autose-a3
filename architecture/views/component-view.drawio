ant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="270" width="210" height="150" as="geometry"/></mxCell><mxCell id="comp-13" value="job: build   perm: contents, pull-requests, issues, actions = write   secret: API key   timeout 45 min" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="760" height="500" as="geometry"/></mxCell><mxCell id="comp-14" value="&lt;b&gt;orchestrator.py&lt;/b&gt;: deterministic state machine (stage, attempt, redesigns, budget $)&lt;br&gt;only process holding GH_TOKEN; agents run with stripped env, checkout persist-credentials: false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="720" height="60" as="geometry"/></mxCell><mxCell id="comp-15" value="&lt;b&gt;Spec agent&lt;/b&gt;&lt;br&gt;claude -p (fresh)&lt;br&gt;+ A1 skill&lt;br&gt;→ spec.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="165" height="90" as="geometry"/></mxCell><mxCell id="comp-16" value="&lt;b&gt;Design agent&lt;/b&gt;&lt;br&gt;claude -p (fresh)&lt;br&gt;+ ARCHITECTURE.md&lt;br&gt;→ design.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="605" y="390" width="165" height="90" as="geometry"/></mxCell><mxCell id="comp-17" value="&lt;b&gt;Implement agent&lt;/b&gt;&lt;br&gt;claude -p (fresh)&lt;br&gt;Read/Edit/Write&lt;br&gt;→ diff.patch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="790" y="390" width="165" height="90" as="geometry"/></mxCell><mxCell id="comp-18" value="&lt;b&gt;Test agent&lt;/b&gt;&lt;br&gt;claude -p (fresh)&