<mxfile host="app.diagrams.net">
  <diagram id="autose-workflow" name="AutoSE agent (LangGraph, orchestrator + test workers + review graph)">
    <mxGraphModel dx="1245" dy="586" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=18;" value="&lt;b&gt;AutoSE agent - LangGraph orchestrator, parallel test workers and an independent review graph&lt;/b&gt;" vertex="1"><mxGeometry height="30" width="1200" x="30" y="15" as="geometry"/></mxCell>
        <mxCell id="c3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" value="Issue in, reviewed pull request out. The main graph writes the spec and design, implements, then the orchestrator splits the acceptance criteria and independent &lt;b&gt;test workers&lt;/b&gt; (subgraphs, each in its own git worktree) write tests in parallel; merge runs the full suite; release opens the PR. A separate &lt;b&gt;review graph&lt;/b&gt; in its own read-only job reviews it; changes send the main graph round again once. Only the red nodes write to GitHub; a human merges. Code: autose/graph.py, nodes.py, workers.py, review.py, run.py" vertex="1"><mxGeometry height="40" width="1290" x="30" y="48" as="geometry"/></mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Issue #N or PR&lt;/b&gt;&lt;br&gt;label &lt;i&gt;autose&lt;/i&gt;, comment&lt;br&gt;&lt;i&gt;/autose&lt;/i&gt;, &lt;i&gt;/autose review&lt;/i&gt;" vertex="1"><mxGeometry height="70" width="160" x="30" y="170" as="geometry"/></mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;gate&lt;/b&gt; (job, no LLM)&lt;br&gt;trusted author? mode&lt;br&gt;build | review | skip;&lt;br&gt;no secrets" vertex="1"><mxGeometry height="80" width="160" x="30" y="280" as="geometry"/></mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#666666;" value="&lt;b&gt;Main graph&lt;/b&gt; - LangGraph StateGraph (AutoSEState, SqliteSaver checkpoint after every node) - runs in job &lt;i&gt;build&lt;/i&gt; and again in &lt;i&gt;rework-1&lt;/i&gt;" vertex="1"><mxGeometry height="560" width="1100" x="220" y="100" as="geometry"/></mxCell>
        <mxCell id="c7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="START" vertex="1"><mxGeometry height="40" width="60" x="240" y="185" as="geometry"/></mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;intake&lt;/b&gt;&lt;br&gt;fetch issue, flag injection&lt;br&gt;text; branch; repo setup" vertex="1"><mxGeometry height="70" width="160" x="320" y="170" as="geometry"/></mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;understand&lt;/b&gt; (stage 1)&lt;br&gt;spec + A1 skill →&lt;br&gt;spec.md; AC lint" vertex="1"><mxGeometry height="70" width="160" x="520" y="170" as="geometry"/></mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;clarify&lt;/b&gt;&lt;br&gt;ACs not testable:&lt;br&gt;questions, no code" vertex="1"><mxGeometry height="60" width="160" x="520" y="290" as="geometry"/></mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;design&lt;/b&gt; (stage 2)&lt;br&gt;+ ARCHITECTURE.md →&lt;br&gt;design.md; refs via AST" vertex="1"><mxGeometry height="70" width="160" x="720" y="170" as="geometry"/></mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;implement&lt;/b&gt; (stage 3)&lt;br&gt;edits src/ only →&lt;br&gt;diff.patch; ruff, mypy" vertex="1"><mxGeometry height="70" width="160" x="920" y="170" as="geometry"/></mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;orchestrator&lt;/b&gt;&lt;br&gt;group ACs (max 4); split&lt;br&gt;token budget (20% reserve);&lt;br&gt;Send workers" vertex="1"><mxGeometry height="90" width="170" x="1130" y="160" as="geometry"/></mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=45;" value="" vertex="1"><mxGeometry height="70" width="170" x="1110" y="290" as="geometry"/></mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=70;" value="" vertex="1"><mxGeometry height="70" width="170" x="1120" y="300" as="geometry"/></mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;criterion_worker x N&lt;/b&gt;&lt;br&gt;(subgraph, parallel,&lt;br&gt;own worktree) tests for&lt;br&gt;its ACs only" vertex="1"><mxGeometry height="70" width="170" x="1130" y="310" as="geometry"/></mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;e2e_worker&lt;/b&gt; (subgraph)&lt;br&gt;regression tests across&lt;br&gt;criteria (only if 2+ groups)" vertex="1"><mxGeometry height="60" width="170" x="1130" y="410" as="geometry"/></mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;merge&lt;/b&gt; (stage 4)&lt;br&gt;write test files, commit;&lt;br&gt;full pytest + AC coverage&lt;br&gt;→ test_report.md" vertex="1"><mxGeometry height="80" width="170" x="920" y="420" as="geometry"/></mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;release&lt;/b&gt; (stage 5)&lt;br&gt;push branch, open PR (pr.md),&lt;br&gt;dispatch tests.yml, wait CI" vertex="1"><mxGeometry height="80" width="180" x="700" y="420" as="geometry"/></mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;stop&lt;/b&gt;&lt;br&gt;reason into the stage's&lt;br&gt;artifact; status failed" vertex="1"><mxGeometry height="60" width="160" x="320" y="560" as="geometry"/></mxCell>
        <mxCell id="c21" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="END" vertex="1"><mxGeometry height="40" width="60" x="245" y="440" as="geometry"/></mxCell>
        <mxCell id="c22" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;fontColor=#555555;" value="stop is reached from design, implement, merge or release when retries run out, and from any node when the token budget is spent." vertex="1"><mxGeometry height="40" width="400" x="500" y="575" as="geometry"/></mxCell>
