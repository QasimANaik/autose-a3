        <mxCell id="c68" edge="1" parent="1" source="c63" target="c64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c69" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;State&lt;/b&gt;&lt;br&gt;&lt;b&gt;AutoSEState&lt;/b&gt; (main): issue, variant, mode, round; issue_data, injection_flags; base, branch, patch (code so far); acs; stages{status, attempts, notes}; attempts, loops, feedback; need_tests; work_items[]; results[] (WorkerResult, list reducer with reset); review (route); pr, ci; status, stopped_at; tokens (sum); events[]&lt;br&gt;&lt;br&gt;&lt;b&gt;WorkerState&lt;/b&gt; (private, per worker): item (its ACs, test file, budget), worktree, tries, check, tokens, result&lt;br&gt;&lt;br&gt;&lt;b&gt;ReviewState&lt;/b&gt;: pr, issue, diff, head_sha, attempt, raw, verdict, tokens" vertex="1"><mxGeometry height="260" width="340" x="1380" y="88" as="geometry"/></mxCell>
        <mxCell id="c70" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;Context per agent&lt;/b&gt;&lt;br&gt;understand: issue (untrusted tags) + A1 skill&lt;br&gt;design: SRS + ARCHITECTURE.md + repo&lt;br&gt;implement: design + AC list (+ failures / review findings)&lt;br&gt;test worker: ITS ACs + src diff, its own worktree; returns only WorkerResult&lt;br&gt;reviewer: issue + PR diff + PR head only&lt;br&gt;&lt;br&gt;&lt;b&gt;Checkpoints and restarts&lt;/b&gt;&lt;br&gt;out/checkpoints.sqlite is uploaded as the build artifact. Re-running a failed build job downloads it, restores the code from &lt;i&gt;patch&lt;/i&gt;, and continues at the pending node." vertex="1"><mxGeometry height="230" width="340" x="1380" y="360" as="geometry"/></mxCell>
        <mxCell id="c71" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt;" vertex="1"><mxGeometry height="25" width="340" x="1340" y="610" as="geometry"/></mxCell>
        <mxCell id="c72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="code only (no AI)" vertex="1"><mxGeometry height="26" width="160" x="1350" y="638" as="geometry"/></mxCell>
        <mxCell id="c73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="calls a model (AI)" vertex="1"><mxGeometry height="26" width="160" x="1520" y="638" as="geometry"/></mxCell>
        <mxCell id="c74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="subagent (subgraph)" vertex="1"><mxGeometry height="26" width="160" x="1350" y="672" as="geometry"/></mxCell>
        <mxCell id="c75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="tools (policy file)" vertex="1"><mxGeometry height="26" width="160" x="1520" y="672" as="geometry"/></mxCell>
        <mxCell id="c76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="writes to GitHub" vertex="1"><mxGeometry height="26" width="160" x="1350" y="706" as="geometry"/></mxCell>
        <mxCell id="c77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="trigger / human" vertex="1"><mxGeometry height="26" width="160" x="1520" y="706" as="geometry"/></mxCell>
        <mxCell id="c78" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="solid arrow = normal edge&lt;br&gt;&lt;font color='#7F00FF'&gt;dashed purple = conditional edge / Send&lt;/font&gt;&lt;br&gt;&lt;font color='#b85450'&gt;dashed red = retry / loop-back&lt;/font&gt;&lt;br&gt;Limits: retries per stage, 2 review rounds, 60 turns per agent call, 4M tokens per job, 3 workers at a time." vertex="1"><mxGeometry height="90" width="330" x="1350" y="740" as="geometry"/></mxCell>
        <mxCell id="c79" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;" value="&lt;b&gt;Every agent call&lt;/b&gt; (agent.py): fresh headless gemini -p; temp HOME; env = PATH, HOME, GEMINI_API_KEY (no GitHub token); admin policy file: read_file, glob, grep, write_file, replace, shell uv run pytest | ruff | mypy | python. Denied: web, git push/commit, gh, curl. Files outside the stage's folder are reverted by code." vertex="1"><mxGeometry height="110" width="340" x="1340" y="840" as="geometry"/></mxCell>
        <mxCell id="c80" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Gemini API&lt;/b&gt; (secret GEMINI_API_KEY)&lt;br&gt;builder + workers: gemini-3-flash-preview&lt;br&gt;reviewer: gemini-3-pro-preview&lt;br&gt;&lt;i&gt;used by: understand, design, implement, workers, reviewer&lt;/i&gt;" vertex="1"><mxGeometry height="110" width="280" x="220" y="1040" as="geometry"/></mxCell>
        <mxCell id="c81" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;GitHub fork&lt;/b&gt; QasimANaik/mistune @ f7ec702&lt;br&gt;issues, branch, PR, reviews, labels; main protected&lt;br&gt;&lt;i&gt;used by: gate, intake, release, intake_pr, publish, finalize&lt;/i&gt;" vertex="1"><mxGeometry height="110" width="290" x="520" y="1040" as="geometry"/></mxCell>
        <mxCell id="c82" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;tests.yml CI (dispatched by release); artifacts carry state and checkpoints between jobs" vertex="1"><mxGeometry height="110" width="240" x="830" y="1040" as="geometry"/></mxCell>
