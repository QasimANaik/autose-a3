        <mxCell id="c64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Human decides&lt;/b&gt;&lt;br&gt;merge or close the PR&lt;br&gt;(the bot never merges)" vertex="1"><mxGeometry height="80" width="180" x="1000" y="920" as="geometry"/></mxCell>
