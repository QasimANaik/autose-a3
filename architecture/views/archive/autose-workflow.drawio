        <mxCell id="c66" edge="1" parent="1" source="c62" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0;exitY=0.5;entryX=0;entryY=0.85;" value="changes requested, round 1 → job rework-1:&lt;br&gt;main graph again, mode=rework (route code → implement,&lt;br&gt;approach → design); then review-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="960"/><mxPoint x="200" y="228"/><mxPoint x="300" y="228"/></Array></mxGeometry></mxCell>
