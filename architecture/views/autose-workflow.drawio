<mxfile host="app.diagrams.net">
  <diagram id="autose-workflow" name="AutoSE workflow (Actions jobs, orchestrator, agents)">
    <mxGraphModel dx="1245" dy="586" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=18;" value="&lt;b&gt;AutoSE workflow - GitHub Actions jobs, orchestrator and agents&lt;/b&gt;" vertex="1"><mxGeometry height="30" width="1000" x="30" y="15" as="geometry"/></mxCell>
        <mxCell id="c3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" value="Issue in, reviewed pull request out. A trusted maintainer labels an issue &lt;b&gt;autose&lt;/b&gt;; the orchestrator runs the builder agent once per stage (fresh context) and checks every stage in code; release opens the PR and waits for CI; an independent reviewer job (read-only, different model) reviews it; changes go back once. Only the red nodes write to GitHub, and a human merges. Details: architecture/decisions/ADR-001..010" vertex="1"><mxGeometry height="40" width="1290" x="30" y="48" as="geometry"/></mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#666666;" value="&lt;b&gt;Main graph&lt;/b&gt; - .github/workflows/autose.yml (one job per box group; &lt;font face='Courier New'&gt;permissions: {}&lt;/font&gt; by default, each job opts in; one run per issue at a time)" vertex="1"><mxGeometry height="560" width="1100" x="220" y="100" as="geometry"/></mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Issue #N or PR&lt;/b&gt;&lt;br&gt;label &lt;i&gt;autose&lt;/i&gt;, comment&lt;br&gt;&lt;i&gt;/autose&lt;/i&gt; or &lt;i&gt;/autose review&lt;/i&gt;" vertex="1"><mxGeometry height="70" width="160" x="30" y="170" as="geometry"/></mxCell>
        <mxCell id="c6" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="START" vertex="1"><mxGeometry height="40" width="60" x="240" y="185" as="geometry"/></mxCell>
        <mxCell id="c7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;gate&lt;/b&gt; (job)&lt;br&gt;trusted author? which mode?&lt;br&gt;event read from file;&lt;br&gt;no secrets, no LLM" vertex="1"><mxGeometry height="80" width="160" x="320" y="165" as="geometry"/></mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;orchestrator.py&lt;/b&gt; (build job)&lt;br&gt;state machine for stages 1-5;&lt;br&gt;retry caps, token budget;&lt;br&gt;reverts edits outside the&lt;br&gt;stage's folder; holds GH_TOKEN" vertex="1"><mxGeometry height="100" width="160" x="520" y="160" as="geometry"/></mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=45;" value="" vertex="1"><mxGeometry height="70" width="160" x="760" y="140" as="geometry"/></mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=70;" value="" vertex="1"><mxGeometry height="70" width="160" x="750" y="150" as="geometry"/></mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;builder agent x 4 stages&lt;/b&gt;&lt;br&gt;gemini -p (Flash), fresh each&lt;br&gt;1 spec  2 design&lt;br&gt;3 implement  4 test" vertex="1"><mxGeometry height="70" width="160" x="740" y="160" as="geometry"/></mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;stage checks&lt;/b&gt; (code)&lt;br&gt;AC lint + A1 validator | design&lt;br&gt;refs (AST) | ruff, strict mypy |&lt;br&gt;AC→test coverage | pytest" vertex="1"><mxGeometry height="80" width="160" x="740" y="285" as="geometry"/></mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;release&lt;/b&gt; (stage 5)&lt;br&gt;push autose/issue-N, open PR&lt;br&gt;(pr.md), dispatch tests.yml,&lt;br&gt;wait for CI" vertex="1"><mxGeometry height="80" width="160" x="960" y="165" as="geometry"/></mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;reviewer&lt;/b&gt; (job review-1 / review-2)&lt;br&gt;gemini -p (Pro), own prompt;&lt;br&gt;sees issue + diff + PR head;&lt;br&gt;runs tests; read-only token" vertex="1"><mxGeometry height="90" width="160" x="1150" y="165" as="geometry"/></mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;publish&lt;/b&gt; (job)&lt;br&gt;post review.md on the PR,&lt;br&gt;label approved /&lt;br&gt;changes-requested; no LLM" vertex="1"><mxGeometry height="80" width="160" x="1150" y="420" as="geometry"/></mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;finalize&lt;/b&gt; (job, always)&lt;br&gt;summary comment + label&lt;br&gt;done | needs-human | failed" vertex="1"><mxGeometry height="70" width="160" x="720" y="425" as="geometry"/></mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Human decides&lt;/b&gt;&lt;br&gt;merge or close the PR&lt;br&gt;(the bot never merges)" vertex="1"><mxGeometry height="80" width="160" x="520" y="420" as="geometry"/></mxCell>
        <mxCell id="c18" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="END" vertex="1"><mxGeometry height="40" width="60" x="245" y="440" as="geometry"/></mxCell>
        <mxCell id="c19" edge="1" parent="1" source="c5" target="c6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" edge="1" parent="1" source="c6" target="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" edge="1" parent="1" source="c7" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="mode = build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" edge="1" parent="1" source="c7" target="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" value="mode = review (seeded PRs)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="128"/><mxPoint x="1230" y="128"/></Array></mxGeometry></mxCell>
        <mxCell id="c23" edge="1" parent="1" source="c7" target="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="skip: untrusted /&lt;br&gt;not a command"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="300"/><mxPoint x="275" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="c24" edge="1" parent="1" source="c8" target="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value="prompt + only the&lt;br&gt;artifacts it needs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" edge="1" parent="1" source="c11" target="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value="artifact"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" edge="1" parent="1" source="c12" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" value="fail: retry / loop back&lt;br&gt;(4→3 ≤2, 4→2 ≤1)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="c27" edge="1" parent="1" source="c12" target="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" value="stage 4 passed"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="325"/></Array></mxGeometry></mxCell>
        <mxCell id="c28" edge="1" parent="1" source="c13" target="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value="PR #"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c29" edge="1" parent="1" source="c14" target="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value="review.md +&lt;br&gt;verdict.json"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" edge="1" parent="1" source="c15" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0;exitY=0.25;entryX=0.75;entryY=1;" value="changes requested, round 1:&lt;br&gt;rework-1 (code → 3, approach → 2)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="440"/><mxPoint x="930" y="395"/><mxPoint x="640" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="c31" edge="1" parent="1" source="c15" target="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" value="approved, or round 2 done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c32" edge="1" parent="1" source="c8" target="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" value="STOP: check still fails&lt;br&gt;after retries"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="405"/><mxPoint x="800" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="c33" edge="1" parent="1" source="c16" target="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c34" edge="1" parent="1" source="c17" target="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#9673a6;" value="&lt;b&gt;Inside one agent call&lt;/b&gt; - agent.py: headless Gemini CLI with a fresh context (the reviewer uses the same runner with its own policy, prompt and model)" vertex="1"><mxGeometry height="210" width="1100" x="220" y="690" as="geometry"/></mxCell>
        <mxCell id="c36" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="start" vertex="1"><mxGeometry height="36" width="50" x="240" y="785" as="geometry"/></mxCell>
        <mxCell id="c37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;prepare&lt;/b&gt;&lt;br&gt;temp HOME + turn limit; A1 skill&lt;br&gt;only for spec; env = PATH, HOME,&lt;br&gt;GEMINI_API_KEY (no GH_TOKEN)" vertex="1"><mxGeometry height="80" width="180" x="320" y="760" as="geometry"/></mxCell>
        <mxCell id="c38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;model&lt;/b&gt;&lt;br&gt;choose next tool or finish&lt;br&gt;(stream-json events logged)" vertex="1"><mxGeometry height="70" width="160" x="540" y="768" as="geometry"/></mxCell>
        <mxCell id="c39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;tools&lt;/b&gt; (admin policy file)&lt;br&gt;read_file, glob, grep, write_file,&lt;br&gt;replace, shell: uv run pytest |&lt;br&gt;ruff | mypy | python. Denied: web,&lt;br&gt;git push/commit, gh, curl" vertex="1"><mxGeometry height="90" width="200" x="760" y="720" as="geometry"/></mxCell>
        <mxCell id="c40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;write output&lt;/b&gt;&lt;br&gt;.autose-work/spec/, design.md,&lt;br&gt;or edits in src/ (stage 3) /&lt;br&gt;tests/ (stage 4)" vertex="1"><mxGeometry height="70" width="200" x="760" y="825" as="geometry"/></mxCell>
        <mxCell id="c41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;return to orchestrator&lt;/b&gt;&lt;br&gt;final text, transcript .jsonl,&lt;br&gt;token stats; then code reverts&lt;br&gt;files outside the stage folder" vertex="1"><mxGeometry height="80" width="190" x="1000" y="790" as="geometry"/></mxCell>
        <mxCell id="c42" edge="1" parent="1" source="c36" target="c37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c43" edge="1" parent="1" source="c37" target="c38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c44" edge="1" parent="1" source="c38" target="c39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" value="tool call"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c45" edge="1" parent="1" source="c39" target="c38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0.25;exitY=0;entryX=0.5;entryY=0;" value="result /&lt;br&gt;denied"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="705"/><mxPoint x="620" y="705"/></Array></mxGeometry></mxCell>
        <mxCell id="c46" edge="1" parent="1" source="c38" target="c40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" value="write"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c47" edge="1" parent="1" source="c40" target="c41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c48" edge="1" parent="1" source="c11" target="c37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#999999;fontColor=#777777;dashed=1;dashPattern=2 3;;exitX=1;exitY=0.85;entryX=0.5;entryY=0;" value="expanded below"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="219"/><mxPoint x="930" y="268"/><mxPoint x="1130" y="268"/><mxPoint x="1130" y="675"/><mxPoint x="410" y="675"/></Array></mxGeometry></mxCell>
        <mxCell id="c49" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;fontColor=#555555;" value="Limits per call: 60 turns, 1200 s, then the attempt fails (exit 53 = turn limit). Per job: 4M tokens. A call that fails before any tool use is retried once on the fallback model." vertex="1"><mxGeometry height="60" width="300" x="1000" y="712" as="geometry"/></mxCell>
        <mxCell id="c50" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;State&lt;/b&gt;&lt;br&gt;&lt;b&gt;out/state.json&lt;/b&gt; (written by the orchestrator after every step): issue, variant, models; stages{status, attempts, notes} for spec, design, implement, test, release; acs (AC id → text); base commit; branch; pr; ci; tokens; events[]&lt;br&gt;&lt;br&gt;&lt;b&gt;Between jobs&lt;/b&gt;: workflow artifacts &lt;i&gt;build&lt;/i&gt;, &lt;i&gt;review-1&lt;/i&gt;, &lt;i&gt;rework-1&lt;/i&gt;, &lt;i&gt;review-2&lt;/i&gt; (the reviewer job never downloads &lt;i&gt;build&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;Between runs&lt;/b&gt;: a new trigger starts fresh from main; the PR branch is force-pushed. The issue gets a summary comment with an &amp;lt;!-- autose-state --&amp;gt; marker." vertex="1"><mxGeometry height="250" width="340" x="1380" y="88" as="geometry"/></mxCell>
        <mxCell id="c51" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;Context per agent&lt;/b&gt;&lt;br&gt;1 spec: issue (in untrusted tags) + A1 skill&lt;br&gt;2 design: SRS + ARCHITECTURE.md + repo&lt;br&gt;3 implement: design + AC list (+ failing test output / review findings on loop-back)&lt;br&gt;4 test: AC list + src diff (no design rationale)&lt;br&gt;review: issue + PR diff + PR-head checkout only; never spec, design, test report or transcripts&lt;br&gt;&lt;br&gt;&lt;b&gt;Agents per issue&lt;/b&gt;&lt;br&gt;4 builder calls per pass (+ retries), 1 reviewer call per round, max 2 review rounds. Stages run one after another; each call starts with an empty context." vertex="1"><mxGeometry height="230" width="340" x="1380" y="350" as="geometry"/></mxCell>
        <mxCell id="c52" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt;" vertex="1"><mxGeometry height="25" width="340" x="1340" y="600" as="geometry"/></mxCell>
        <mxCell id="c53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="code only (no AI)" vertex="1"><mxGeometry height="26" width="160" x="1350" y="628" as="geometry"/></mxCell>
        <mxCell id="c54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="calls a model (AI)" vertex="1"><mxGeometry height="26" width="160" x="1520" y="628" as="geometry"/></mxCell>
        <mxCell id="c55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="agent call (fresh gemini -p)" vertex="1"><mxGeometry height="26" width="160" x="1350" y="662" as="geometry"/></mxCell>
        <mxCell id="c56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" value="tool runner (policy-gated)" vertex="1"><mxGeometry height="26" width="160" x="1520" y="662" as="geometry"/></mxCell>
        <mxCell id="c57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="writes to GitHub" vertex="1"><mxGeometry height="26" width="160" x="1350" y="696" as="geometry"/></mxCell>
        <mxCell id="c58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="trigger / human" vertex="1"><mxGeometry height="26" width="160" x="1520" y="696" as="geometry"/></mxCell>
