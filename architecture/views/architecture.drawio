        <mxCell id="c60" edge="1" parent="1" source="c19" target="c48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="PR # → job review-1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="917" y="770"/><mxPoint x="275" y="770"/></Array></mxGeometry></mxCell>
        <mxCell id="c61" edge="1" parent="1" source="c5" target="c48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" value="mode=review&lt;br&gt;(seeded PRs)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="908"/></Array></mxGeometry></mxCell>
        <mxCell id="c62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;publish&lt;/b&gt; (job, no LLM)&lt;br&gt;post review.md on the PR; label approved / changes-requested; outputs verdict + route&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="120" width="210" x="330" y="1060" as="geometry"/></mxCell>
        <mxCell id="c63" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;finalize&lt;/b&gt; (job, always)&lt;br&gt;summary comment with stage table, stop reason and tokens; label done | needs-human | failed&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="120" width="210" x="760" y="1060" as="geometry"/></mxCell>
        <mxCell id="c64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Human decides&lt;/b&gt;&lt;br&gt;merge or close the PR. The bot never merges; CODEOWNERS makes a bot approval useless for merging" vertex="1"><mxGeometry height="120" width="210" x="1040" y="1060" as="geometry"/></mxCell>
        <mxCell id="c65" edge="1" parent="1" source="c53" target="c62" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="verdict.json"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1315" y="1040"/><mxPoint x="435" y="1040"/></Array></mxGeometry></mxCell>
        <mxCell id="c66" edge="1" parent="1" source="c62" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0;exitY=0.5;entryX=0;entryY=0.9;" value="changes requested, round 1 → job rework-1: main graph again (route code → implement, approach → design), then review-2&lt;br&gt;&lt;font color='#0b6e4f'&gt;≈ $1.95 per rework round&lt;/font&gt;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="1120"/><mxPoint x="215" y="285"/><mxPoint x="320" y="285"/></Array></mxGeometry></mxCell>
        <mxCell id="c67" edge="1" parent="1" source="c62" target="c63" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value="approved, or round 2 done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c68" edge="1" parent="1" source="c63" target="c64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c69" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f0f8f4;strokeColor=#0b6e4f;" value="&lt;b&gt;Estimated cost&lt;/b&gt; (Gemini API, Standard paid tier)&lt;br&gt;&lt;table border='1' cellpadding='2' style='border-collapse:collapse;font-size:10px'&gt;&lt;tr&gt;&lt;th&gt;agent node&lt;/th&gt;&lt;th&gt;model&lt;/th&gt;&lt;th&gt;turns&lt;/th&gt;&lt;th&gt;tokens in / out&lt;/th&gt;&lt;th&gt;USD&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;understand&lt;/td&gt;&lt;td&gt;flash&lt;/td&gt;&lt;td align='right'&gt;15&lt;/td&gt;&lt;td align='right'&gt;450k / 22k&lt;/td&gt;&lt;td align='right'&gt;&lt;b&gt;$0.21&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;design&lt;/td&gt;&lt;td&gt;flash&lt;/td&gt;&lt;td align='right'&gt;20&lt;/td&gt;&lt;td align='right'&gt;800k / 24k&lt;/td&gt;&lt;td align='right'&gt;&lt;b&gt;$0.31&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;implement&lt;/td&gt;&lt;td&gt;flash&lt;/td&gt;&lt;td align='right'&gt;25&lt;/td&gt;&lt;td align='right'&gt;1250k / 37k&lt;/td&gt;&lt;td align='right'&gt;&lt;b&gt;$0.49&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;test worker (each)&lt;/td&gt;&lt;td&gt;flash&lt;/td&gt;&lt;td align='right'&gt;12&lt;/td&gt;&lt;td align='right'&gt;360k / 12k&lt;/td&gt;&lt;td align='right'&gt;&lt;b&gt;$0.14&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;reviewer (per round)&lt;/td&gt;&lt;td&gt;pro&lt;/td&gt;&lt;td align='right'&gt;20&lt;/td&gt;&lt;td align='right'&gt;900k / 30k&lt;/td&gt;&lt;td align='right'&gt;&lt;b&gt;$1.03&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Per issue run&lt;/b&gt;&lt;br&gt;• build job (spec + design + implement + 3 workers): &lt;b&gt;$1.44&lt;/b&gt;, ~3.7M tokens&lt;br&gt;• happy path (+ 1 review round): &lt;b&gt;$2.47&lt;/b&gt;&lt;br&gt;• with one rework round (+ implement, workers, review-2): &lt;b&gt;$4.42&lt;/b&gt;&lt;br&gt;• worst case (every retry used): &lt;b&gt;≈ $11&lt;/b&gt;, but the 8M-token cap per job stops it earlier&lt;br&gt;• seeded-PR review only: &lt;b&gt;$1.03&lt;/b&gt;; weak-reviewer variant (Flash, read-only): &lt;b&gt;≈ $0.23&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Whole assignment&lt;/b&gt; (5 issues, ~1 rework each; 5 seeded PRs x 2 reviewer variants; E2: 5 issues x 2 variants up to design): &lt;b&gt;≈ $34&lt;/b&gt; (range about half to double).&lt;br&gt;&lt;br&gt;&lt;b&gt;Assumptions&lt;/b&gt;: each turn re-sends the whole context (Gemini CLI system prompt + tools ≈ 12k tokens, plus files read so far); 70% of input is served from Gemini's implicit cache; output includes thinking tokens. Prices per 1M tokens (in / cached / out): gemini-3.8-flash $0.75 / $0.075 / $3.75 (until 2026-12-31, then double); gemini-3.1-pro-preview $2.00 / $0.20 / $12.00 (prompts ≤ 200k). Source: aistudio.google.com/docs/pricing, 2026-11-24. GitHub Actions minutes are free for a public repo. &lt;b&gt;Replace these estimates with out/usage/*.json after the real runs.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Free tier&lt;/b&gt;: one agent call = one API request per turn, so one issue run is roughly 100-150 requests; the Flash free tier's daily request limit is far below that, and Pro has no free tier, so the runs need billing with a budget cap." vertex="1"><mxGeometry height="700" width="380" x="1540" y="88" as="geometry"/></mxCell>
        <mxCell id="c70" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;State&lt;/b&gt; (checkpointed; carried between jobs as workflow artifacts)&lt;br&gt;&lt;b&gt;AutoSEState&lt;/b&gt;: issue, variant, mode; issue_data, injection_flags; base, branch, patch (code so far); acs; stages{status, attempts, notes}; attempts, loops, feedback; need_tests; work_items; results[] (reducer); review route; pr, ci; status, stopped_at, stop_reason; tokens; events&lt;br&gt;&lt;b&gt;WorkerState&lt;/b&gt; (private): its ACs, test file, worktree, tries, result&lt;br&gt;&lt;b&gt;ReviewState&lt;/b&gt;: pr, issue, diff, head_sha, verdict, tokens&lt;br&gt;A re-run build job resumes at the pending node and restores the code from &lt;i&gt;patch&lt;/i&gt;." vertex="1"><mxGeometry height="215" width="380" x="1540" y="805" as="geometry"/></mxCell>
        <mxCell id="c71" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Legend&lt;/b&gt;" vertex="1"><mxGeometry height="22" width="380" x="1540" y="1035" as="geometry"/></mxCell>
        <mxCell id="c72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="code only (no AI)" vertex="1"><mxGeometry height="26" width="185" x="1540" y="1060" as="geometry"/></mxCell>
        <mxCell id="c73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="calls a model (AI)" vertex="1"><mxGeometry height="26" width="185" x="1735" y="1060" as="geometry"/></mxCell>
        <mxCell id="c74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="subagent (subgraph)" vertex="1"><mxGeometry height="26" width="185" x="1540" y="1092" as="geometry"/></mxCell>
        <mxCell id="c75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="tools (policy file)" vertex="1"><mxGeometry height="26" width="185" x="1735" y="1092" as="geometry"/></mxCell>
        <mxCell id="c76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="writes to GitHub" vertex="1"><mxGeometry height="26" width="185" x="1540" y="1124" as="geometry"/></mxCell>
        <mxCell id="c77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="trigger / human" vertex="1"><mxGeometry height="26" width="185" x="1735" y="1124" as="geometry"/></mxCell>
        <mxCell id="c78" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="solid = normal edge · &lt;font color='#7F00FF'&gt;dashed purple = conditional / Send&lt;/font&gt; · &lt;font color='#b85450'&gt;dashed red = retry / loop-back&lt;/font&gt;" vertex="1"><mxGeometry height="30" width="380" x="1540" y="1156" as="geometry"/></mxCell>
        <mxCell id="c79" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" value="&lt;b&gt;Every agent call&lt;/b&gt; (agent.py): fresh headless &lt;i&gt;gemini -p&lt;/i&gt; with an empty context; temp HOME; env = PATH, HOME, GEMINI_API_KEY only (no GitHub token); admin policy file allows read_file, glob, grep, write_file, replace, shell uv run pytest | ruff | mypy | python; denies web, git push / commit, gh, curl; 60 turns, 1200 s. A failure before any work (quota, retired model) is retried once on the fallback model, then stops the run with the reason." vertex="1"><mxGeometry height="60" width="1270" x="230" y="1200" as="geometry"/></mxCell>
        <mxCell id="c80" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Gemini API&lt;/b&gt; (secret GEMINI_API_KEY)&lt;br&gt;builder + workers: gemini-3.8-flash&lt;br&gt;reviewer: gemini-3.1-pro-preview" vertex="1"><mxGeometry height="75" width="290" x="230" y="1280" as="geometry"/></mxCell>
        <mxCell id="c81" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;GitHub fork&lt;/b&gt; QasimANaik/mistune @ f7ec702&lt;br&gt;issues, branch, PR, reviews, labels; main protected" vertex="1"><mxGeometry height="75" width="300" x="540" y="1280" as="geometry"/></mxCell>
        <mxCell id="c82" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;8 jobs; tests.yml CI dispatched by release; artifacts carry checkpoints" vertex="1"><mxGeometry height="75" width="300" x="860" y="1280" as="geometry"/></mxCell>
        <mxCell id="c83" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Reused inputs&lt;/b&gt;&lt;br&gt;A1 skill requirements-spec + validator; A2 ARCHITECTURE.md" vertex="1"><mxGeometry height="75" width="320" x="1180" y="1280" as="geometry"/></mxCell>
        <mxCell id="c84" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Run records&lt;/b&gt; (artifacts)&lt;br&gt;spec.md, design.md, diff.patch, test_report.md, pr.md, review.md, verdict.json, state.json, checkpoints.sqlite, transcripts/, usage/ (tokens)" vertex="1"><mxGeometry height="155" width="380" x="1540" y="1200" as="geometry"/></mxCell>
