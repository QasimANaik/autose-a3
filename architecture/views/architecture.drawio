<mxfile host="app.diagrams.net">
  <diagram id="autose-architecture" name="AutoSE architecture + costs">
    <mxGraphModel dx="1245" dy="586" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=18;" value="&lt;b&gt;AutoSE - architecture of the issue-to-PR workflow (LangGraph agents + GitHub Actions jobs), with estimated cost per node&lt;/b&gt;" vertex="1"><mxGeometry height="30" width="1500" x="30" y="15" as="geometry"/></mxCell>
        <mxCell id="c3" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" value="A trusted maintainer labels an issue &lt;b&gt;autose&lt;/b&gt;. The &lt;b&gt;main graph&lt;/b&gt; (job build) writes the spec and the design, implements the change, sends &lt;b&gt;parallel test workers&lt;/b&gt; (one per acceptance-criterion group, each in its own git worktree), merges and runs the full suite, then opens the PR and waits for CI. The &lt;b&gt;review graph&lt;/b&gt; runs in its own read-only job with a different model. Changes requested send the main graph round once more (job rework-1). Every route is decided by code; only red nodes write to GitHub; a human merges. &lt;font color='#0b6e4f'&gt;Green figures = estimated Gemini cost per node (paid tier, see the cost panel).&lt;/font&gt;" vertex="1"><mxGeometry height="50" width="1480" x="30" y="48" as="geometry"/></mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Issue #N or PR&lt;/b&gt; (fork)&lt;br&gt;label &lt;i&gt;autose&lt;/i&gt;, comment &lt;i&gt;/autose&lt;/i&gt;, or &lt;i&gt;/autose review&lt;/i&gt; on a PR" vertex="1"><mxGeometry height="80" width="170" x="30" y="160" as="geometry"/></mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;gate&lt;/b&gt; (job, no LLM)&lt;br&gt;reads the event file; accepts only OWNER / MEMBER / COLLABORATOR, ignores bots; mode = build | review | skip; label autose:running + 'run started' comment&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="175" width="170" x="30" y="270" as="geometry"/></mxCell>
        <mxCell id="c6" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#666666;" value="&lt;b&gt;Main graph&lt;/b&gt; - LangGraph StateGraph (AutoSEState, SQLite checkpoint after every node); job &lt;i&gt;build&lt;/i&gt;, and again in job &lt;i&gt;rework-1&lt;/i&gt;. Each agent node = one fresh headless &lt;i&gt;gemini -p&lt;/i&gt; call (builder model gemini-3.8-flash)" vertex="1"><mxGeometry height="660" width="1270" x="230" y="100" as="geometry"/></mxCell>
        <mxCell id="c7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="START" vertex="1"><mxGeometry height="40" width="60" x="250" y="210" as="geometry"/></mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;intake&lt;/b&gt; (code)&lt;br&gt;fetch issue via gh; flag injection-like phrases (kept as data); create branch autose/issue-N; repo setup&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="130" width="185" x="330" y="170" as="geometry"/></mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;understand&lt;/b&gt; - stage 1&lt;br&gt;A1 &lt;i&gt;requirements-spec&lt;/i&gt; skill, batch mode → SRS / REG / VAL → &lt;b&gt;spec.md&lt;/b&gt;. Check (code): every AC has an id + Given/When/Then, no vague words&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;≈ $0.21&lt;/b&gt; · ~450k in / 22k out&lt;/font&gt;" vertex="1"><mxGeometry height="150" width="190" x="540" y="170" as="geometry"/></mxCell>
        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;clarify&lt;/b&gt; (code)&lt;br&gt;ACs still not testable after 1 retry: write open questions, no code; status needs_clarification&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="110" width="190" x="540" y="350" as="geometry"/></mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;design&lt;/b&gt; - stage 2&lt;br&gt;reads ARCHITECTURE.md + code → &lt;b&gt;design.md&lt;/b&gt; (files and functions to change, plan, risks). Check (code): every named file / function exists (AST)&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;≈ $0.31&lt;/b&gt; · ~800k in / 24k out&lt;/font&gt;" vertex="1"><mxGeometry height="150" width="190" x="755" y="170" as="geometry"/></mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;implement&lt;/b&gt; - stage 3&lt;br&gt;edits &lt;b&gt;src/&lt;/b&gt; only (other edits reverted) → &lt;b&gt;diff.patch&lt;/b&gt;. Check (code): import, ruff, strict mypy; commit&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;≈ $0.49&lt;/b&gt; · ~1250k in / 37k out&lt;/font&gt;" vertex="1"><mxGeometry height="150" width="190" x="970" y="170" as="geometry"/></mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;orchestrator&lt;/b&gt; (code) - stage 4&lt;br&gt;group ACs per requirement (max 4 groups); token budget split with 20% reserve; &lt;i&gt;Send&lt;/i&gt; one worker per group (+ e2e if 2+ groups)&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="150" width="190" x="1290" y="160" as="geometry"/></mxCell>
        <mxCell id="c14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=45;" value="" vertex="1"><mxGeometry height="135" width="190" x="1270" y="335" as="geometry"/></mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=70;" value="" vertex="1"><mxGeometry height="135" width="190" x="1280" y="345" as="geometry"/></mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;criterion_worker x N&lt;/b&gt; (subgraph)&lt;br&gt;own git worktree; writes ONE test file for ITS ACs; runs it; 1 retry if an AC is uncovered; returns WorkerResult&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;≈ $0.14&lt;/b&gt; x2 = $0.29 · ~360k in / 12k out&lt;/font&gt;" vertex="1"><mxGeometry height="135" width="190" x="1290" y="355" as="geometry"/></mxCell>
        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;e2e_worker&lt;/b&gt; (subgraph)&lt;br&gt;regression + cross-criteria tests in one file (only with 2+ groups)&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;≈ $0.14&lt;/b&gt; · ~360k in / 12k out&lt;/font&gt;" vertex="1"><mxGeometry height="115" width="190" x="1290" y="515" as="geometry"/></mxCell>
        <mxCell id="c18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;merge&lt;/b&gt; (code) - stage 4&lt;br&gt;write the workers' files, commit; full pytest + AC→test coverage → &lt;b&gt;test_report.md&lt;/b&gt;; stops on a model outage&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="140" width="190" x="1050" y="500" as="geometry"/></mxCell>
        <mxCell id="c19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;" value="&lt;b&gt;release&lt;/b&gt; (code) - stage 5&lt;br&gt;push branch, open PR (&lt;b&gt;pr.md&lt;/b&gt;), dispatch tests.yml, wait; re-run failed CI jobs once (flaky timing tests)&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="140" width="195" x="820" y="500" as="geometry"/></mxCell>
        <mxCell id="c20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;stop&lt;/b&gt; (code)&lt;br&gt;append 'why this stage stopped' to the stage's artifact; status failed&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="110" width="185" x="330" y="610" as="geometry"/></mxCell>
        <mxCell id="c21" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="END" vertex="1"><mxGeometry height="40" width="60" x="255" y="545" as="geometry"/></mxCell>
        <mxCell id="c22" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=10;fontColor=#555555;" value="&lt;i&gt;stop&lt;/i&gt; is reached from design, implement, merge or release when their retries run out, from any agent node when the model is unavailable (quota / retired model), and when the 8M-token job budget is spent." vertex="1"><mxGeometry height="60" width="460" x="540" y="660" as="geometry"/></mxCell>
        <mxCell id="c23" edge="1" parent="1" source="c4" target="c5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" edge="1" parent="1" source="c5" target="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="mode=build"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="357"/><mxPoint x="215" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="c25" edge="1" parent="1" source="c7" target="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" edge="1" parent="1" source="c8" target="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" edge="1" parent="1" source="c9" target="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.75;exitY=0;entryX=0.25;entryY=0;" value="retry ≤1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="140"/><mxPoint x="580" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="c28" edge="1" parent="1" source="c9" target="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="testable"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c29" edge="1" parent="1" source="c9" target="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="not testable"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" edge="1" parent="1" source="c10" target="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="c31" edge="1" parent="1" source="c11" target="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.75;exitY=0;entryX=0.25;entryY=0;" value="retry ≤1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="140"/><mxPoint x="795" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="c32" edge="1" parent="1" source="c11" target="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="refs exist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c33" edge="1" parent="1" source="c12" target="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.75;exitY=0;entryX=0.25;entryY=0;" value="retry ≤2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="140"/><mxPoint x="1010" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="c34" edge="1" parent="1" source="c12" target="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="builds; tests needed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" edge="1" parent="1" source="c12" target="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" value="builds; tests exist"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="470"/><mxPoint x="1100" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="c36" edge="1" parent="1" source="c13" target="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="Send x N"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" edge="1" parent="1" source="c13" target="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0;exitY=0.8;entryX=0;entryY=0.5;" value="Send"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="280"/><mxPoint x="1255" y="572"/></Array></mxGeometry></mxCell>
        <mxCell id="c38" edge="1" parent="1" source="c16" target="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" value="WorkerResult"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1385" y="495"/><mxPoint x="1200" y="495"/></Array></mxGeometry></mxCell>
        <mxCell id="c39" edge="1" parent="1" source="c17" target="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" value="WorkerResult"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c40" edge="1" parent="1" source="c18" target="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" value="AC without a test:&lt;br&gt;re-send weak criteria only (once)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145" y="700"/><mxPoint x="1492" y="700"/><mxPoint x="1492" y="235"/></Array></mxGeometry></mxCell>
        <mxCell id="c41" edge="1" parent="1" source="c18" target="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.75;exitY=0;entryX=0.85;entryY=1;" value="tests fail (≤2)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="335"/></Array></mxGeometry></mxCell>
        <mxCell id="c42" edge="1" parent="1" source="c18" target="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.1;exitY=0;entryX=0.75;entryY=1;" value="still failing:&lt;br&gt;redesign (≤1)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="450"/><mxPoint x="900" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="c43" edge="1" parent="1" source="c18" target="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;" value="suite green,&lt;br&gt;every AC tested"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c44" edge="1" parent="1" source="c19" target="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#7F00FF;fontColor=#7F00FF;;exitX=0;exitY=0.45;entryX=1;entryY=0.5;" value="PR open, CI green"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="565"/></Array></mxGeometry></mxCell>
        <mxCell id="c45" edge="1" parent="1" source="c19" target="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;strokeColor=#b85450;fontColor=#b85450;;exitX=0.15;exitY=0;entryX=0.15;entryY=1;" value="CI fails (once)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="345"/><mxPoint x="1000" y="345"/></Array></mxGeometry></mxCell>
        <mxCell id="c46" edge="1" parent="1" source="c20" target="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#333333;;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="665"/></Array></mxGeometry></mxCell>
        <mxCell id="c47" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeColor=#b85450;" value="&lt;b&gt;Review graph&lt;/b&gt; - separate jobs &lt;i&gt;review-1&lt;/i&gt; / &lt;i&gt;review-2&lt;/i&gt;: read-only token, reviewer model &lt;b&gt;gemini-3.1-pro-preview&lt;/b&gt;, own prompt and checkpointer; sees ONLY the issue, the PR diff and the PR-head checkout; never downloads the build artifacts" vertex="1"><mxGeometry height="230" width="1270" x="230" y="790" as="geometry"/></mxCell>
        <mxCell id="c48" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="start" vertex="1"><mxGeometry height="36" width="50" x="250" y="890" as="geometry"/></mxCell>
        <mxCell id="c49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;intake_pr&lt;/b&gt; (code)&lt;br&gt;linked issue (Fixes #N) + gh pr diff; PR body and builder artifacts are NOT passed&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="120" width="190" x="330" y="860" as="geometry"/></mxCell>
        <mxCell id="c50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;reviewer&lt;/b&gt; - stage 6&lt;br&gt;adversarial checklist: reproduce the issue's examples, run pytest, look for regressions, XSS, empty tests; every finding needs evidence; verdict JSON&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;≈ $1.03&lt;/b&gt; · ~900k in / 30k out&lt;/font&gt;" vertex="1"><mxGeometry height="150" width="220" x="555" y="845" as="geometry"/></mxCell>
        <mxCell id="c51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;judge&lt;/b&gt; (code)&lt;br&gt;drop findings without evidence; approve + blocker → request changes; approve without listing checks → ask again once&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="130" width="200" x="810" y="855" as="geometry"/></mxCell>
        <mxCell id="c52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;verticalAlign=top;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;render&lt;/b&gt; (code)&lt;br&gt;review.md + verdict.json (verdict, route code | approach)&lt;br&gt;&lt;font color='#0b6e4f'&gt;&lt;b&gt;$0&lt;/b&gt; LLM · Actions minutes free (public repo)&lt;/font&gt;" vertex="1"><mxGeometry height="110" width="190" x="1045" y="865" as="geometry"/></mxCell>
        <mxCell id="c53" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#1a1a1a;fontStyle=1;fontSize=10;" value="end" vertex="1"><mxGeometry height="36" width="50" x="1290" y="890" as="geometry"/></mxCell>
