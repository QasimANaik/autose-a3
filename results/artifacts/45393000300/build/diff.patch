+
+def clean_url_text(text: str) -> str:
+    while text:
+        last = text[-1]
+        if last in '.,;:?!\'"':
+            text = text[:-1]
+        elif last == ')':
+            if text.count('(') < text.count(')'):
+                text = text[:-1]
+            else:
+                break
+        else:
+            break
+    return text
 
 
